    c001: *id001
    c002: *id002
    g001: *id003
    g002: *id004
fn_management:
  hosts:
    mgt1: *id005
hw_cpu_server_type_A:
  hosts:
    c001: *id001
    c002: *id002
hw_cpu_server_type_C:
  hosts:
    mgt1: *id005
hw_gpu_server_type_B:
  hosts:
    g001: *id003
    g002: *id004
os_ubuntu_22:
  hosts:
    g001: *id003
    g002: *id004
  vars:
    bb_domain_name: bluebanquise.cluster.local
    bb_repositories: null
    bb_time_zone: Europe/Brussels
    networks: &id006
      external-network:
        prefix: 24
        subnet: 192.168.1.0
      net-admin:
        dhcp_server: true
        dns_server: true
        prefix: 16
        services_ip: 10.10.0.1
        subnet: 10.10.0.0
    nfs_client_directories_state: present
    nfs_shares: &id007
    - clients_groups:
      - fn_compute
      export: /data/home
      export_options: rw,sync
      mount: /home
      mount_options: rw,nfsvers=3,bg
      server: mgt1
      take_over_network: net-admin
    prometheus_exporters_groups_to_scrape: &id008
      fn_compute:
      - name: node_exporter
        package: node_exporter
        port: 9100
        service: node_exporter
    prometheus_server_manage_alertmanager: false
    prometheus_server_manage_karma: false
    prometheus_server_manage_prometheus: true
os_ubuntu_24:
  hosts:
    c001: *id001
    c002: *id002
    mgt1: *id005
  vars:
    bb_domain_name: bluebanquise.cluster.local
    bb_repositories: null
    bb_time_zone: Europe/Brussels
    networks: *id006
    nfs_client_directories_state: present
    nfs_shares: *id007
    os_operating_system:
      distribution: ubuntu
      distribution_major_version: 24
      distribution_version: 24.04
    prometheus_exporters_groups_to_scrape: *id008
    prometheus_server_manage_alertmanager: false
    prometheus_server_manage_karma: false
    prometheus_server_manage_prometheus: true
